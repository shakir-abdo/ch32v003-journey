# Build artifacts — regenerated inside the image
.nuxt/
.output/
dist/
node_modules/

# Source control
.git/
.gitignore
.gitattributes

# Local env — never bake secrets into images
.env
.env.local
.env.*.local

# IDE + OS
.vscode/
.idea/
.cursor/
*.swp
.DS_Store
Thumbs.db

# Tooling caches
.eslintcache
.cache/
coverage/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker files themselves (don't recurse)
Dockerfile
docker-compose*.yml
.dockerignore

# Test artifacts
playwright-report/
test-results/

# Agent + skill metadata stays out of the image — used at dev time only
.claude/

# Spike folder is the compiler service's own build context (see
# docker-compose.yml). Don't ship its 1.1 GB toolchain with the Nuxt image.
spikes/

# Misc dev files
project_progress.md
README.md
*.md
!app/**/*.md
!server/**/*.md
!i18n/**/*.md
!content/**/*.md          # lesson markdown MUST stay in the image
LICENSE
LICENSE-CONTENT

# Stale lockfile from the npm-based template — we use pnpm-lock.yaml
package-lock.json
auth.d.ts
skills-lock.json
CLAUDE.md
skills/
